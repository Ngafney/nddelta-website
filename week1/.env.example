# Week 1 API — environment. Copy to .env for local dev, or set these in the
# Vercel project's Environment Variables for production.

# REQUIRED IN PRODUCTION. Signs team tokens and the admin token. Team IDs are
# public (they show on the leaderboard), so with the default secret anyone can
# forge any team's token AND the admin token from public data. The server
# REFUSES TO BOOT in production (VERCEL=1 / NODE_ENV=production) unless this is
# set to something other than the default. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Upstash Redis — add the Upstash integration in Vercel and these appear
# automatically. Without them, storage is per-invocation memory (nothing
# persists on Vercel); the admin panel shows a banner when that's the case.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The strategy compiler. With a key, the AI compiles a student's English into
# a strategy spec — faithfully, and refusing vague "just make me win" asks.
# Without a key a deterministic offline parser stands in (no refusals, but the
# app still runs). OpenAI-compatible; OPENAI_BASE_URL overrides the endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Bump to reroll the shared 10,000 bandit worlds (invalidates algo scores).
WORLD_SEED=delta-week1-v1

# The admin panel's starting password. Defaults to 123 (changeable in-panel).
# Safe to leave at 123 ONLY because SESSION_SECRET is what actually secures the
# admin token — with a real secret, knowing the password still requires the
# panel, and the token can't be forged.
# ADMIN_PASSWORD=123
