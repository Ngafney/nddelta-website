# Week 5 API — environment. Copy to .env for local dev, or set these in the
# Vercel project's Environment Variables for production. NEVER commit a filled
# copy: week5/.env is gitignored, and this week has no committed store config.

# REQUIRED IN PRODUCTION. Signs player tokens and the admin token. Player IDs
# travel to the browser, so with a default secret anyone could forge another
# player's session AND the admin token. The server REFUSES TO BOOT in
# production (VERCEL=1 / NODE_ENV=production) unless this is set. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Upstash Redis — add the Upstash integration in Vercel and these appear
# automatically (KV_REST_API_URL / KV_REST_API_TOKEN are read too). Without
# them, storage is per-invocation memory (nothing persists on Vercel); the
# admin panel shows a banner when that's the case. For a live room, running
# `node serve.js` on one machine behind a tunnel is the cheapest and fastest
# option — memory mode, zero Redis traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The admin panel's starting password. Defaults to 123 (changeable in-panel).
# Safe only because SESSION_SECRET is what actually secures the admin token.
# ADMIN_PASSWORD=123

# Force the in-process store even when Upstash vars exist (tests, a live room).
# KV_FORCE_MEMORY=1
