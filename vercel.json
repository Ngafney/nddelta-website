{
  "rewrites": [
    {
      "source": "/week1/board",
      "destination": "/week1/index.html"
    },
    {
      "source": "/week1/admin",
      "destination": "/week1/index.html"
    },
    {
      "source": "/api/week1/:path*",
      "destination": "/api/week1/router?__path=:path*"
    },
    {
      "source": "/week2/board",
      "destination": "/week2/index.html"
    },
    {
      "source": "/week2/admin",
      "destination": "/week2/index.html"
    },
    {
      "source": "/api/week2/:path*",
      "destination": "/api/week2/router?__path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/week2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/week2/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/week2/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/week2/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/week2/board",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
