# Week 3 API — environment. Copy to .env for local dev, or set these in the
# Vercel project's Environment Variables for production.

# REQUIRED IN PRODUCTION. Signs player tokens and the admin token. Player IDs
# travel to the browser, so with a default secret anyone could forge another
# player's session AND the admin token. The server REFUSES TO BOOT in
# production (VERCEL=1 / NODE_ENV=production) unless this is set. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Upstash Redis — add the Upstash integration in Vercel and these appear
# automatically. Without them, storage is per-invocation memory (nothing
# persists on Vercel); the admin panel shows a banner when that's the case.
# For a 60-person live round, running `node serve.js` on one machine behind a
# tunnel is the cheapest and fastest option — memory mode, zero Redis traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The bandit lab's strategy compiler (same as week 1). With a key, the AI
# compiles English into code and refuses "just make me win" requests. Without
# one, an offline quick-compiler that reads the common phrasings stands in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Bump to reroll the 10,000 shared bandit games (clear the bandit board too).
# BANDIT_SEED=delta-week3-bandit-v1

# The admin panel's starting password. Defaults to 123 (changeable in-panel).
# Safe only because SESSION_SECRET is what actually secures the admin token.
# ADMIN_PASSWORD=123
